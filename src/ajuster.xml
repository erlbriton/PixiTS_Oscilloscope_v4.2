<file path="css/oscilloscope.css">
#osc-container {
    display: flex;
    flex-direction: column; /* Теперь это колонка: сверху тулбар, снизу рабочая область */
    flex: 1;
    height: 100%;
    width: 100%;
    overflow: hidden;
    background: #000;
}

/* =========================================
   ПАНЕЛЬ ИНСТРУМЕНТОВ И КНОПКИ (Ретро 3D Темная Тема)
   ========================================= */
.osc-toolbar {
    display: flex;
    flex: 0 0 auto;
    padding: 4px 6px;
    background: #333333; /* Базовый темный фон панели */
    border-bottom: 2px solid #1a1a1a;
    gap: 4px;
}

.osc-btn {
    width: 60px;
    height: 30px;
    background: #3a3a3a; /* Цвет самой кнопки */
    /* Имитация 3D-выпуклости */
    border-top: 2px solid #5d5d5d;
    border-left: 2px solid #5d5d5d;
    border-bottom: 2px solid #151515;
    border-right: 2px solid #151515;
    border-radius: 0; /* Классические кнопки строго прямоугольные */
    color: #cccccc;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    outline: none;
    box-sizing: border-box;
}

.osc-btn:hover {
    background: #424242;
    color: #ffffff;
}

/* Эффект вдавленности при нажатии */
.osc-btn:active {
    background: #333333;
    border-top: 2px solid #151515;
    border-left: 2px solid #151515;
    border-bottom: 2px solid #5d5d5d;
    border-right: 2px solid #5d5d5d;
}

/* Сдвиг иконки при нажатии для реалистичности */
.osc-btn:active svg {
    transform: translate(1px, 1px);
}

.osc-btn svg {
    width: 20px;
    height: 20px;
}

/* =========================================
   ОСНОВНАЯ РАБОЧАЯ ОБЛАСТЬ (Таблица + Графики)
   ========================================= */
.osc-main-area {
    display: flex;
    flex: 1;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

/* Обертка таблицы */
.osc-table-wrapper {
    flex: 0 0 460px;
    height: 100%;
    overflow-y: auto;
    overflow-x: hidden;
    background: #0a0a0a;
}

/* Главный разделитель между таблицей и графиками */
.osc-main-splitter {
    width: 4px;
    background: #333;
    cursor: col-resize;
    flex: 0 0 auto;
    z-index: 100;
}

.osc-main-splitter:hover, .osc-main-splitter.active {
    background: #0055ff;
}

.osc-data-grid {
    table-layout: fixed;
    width: 100%;
    border-collapse: collapse;
}

.osc-data-grid th {
    background: #222;
    color: #aaa;
    padding: 6px 8px;
    font-size: 14px;
    border-right: 1px solid #333;
    border-bottom: 2px solid #333;
    position: relative;
    height: 31px;
}

/* Внутренние ресайзеры колонок */
.osc-table-resizer {
    position: absolute;
    right: 0;
    top: 0;
    width: 8px;
    height: 100%;
    cursor: col-resize;
    z-index: 10;
}

.osc-table-resizer:hover, .osc-table-resizer.active {
    background: rgba(0, 85, 255, 0.3);
}

/* Область графиков */
.osc-canvas-column {
    flex: 1;
    min-width: 0;
    height: 100%;
    background: #000;
    position: relative;
    overflow: hidden;
}
</file>

