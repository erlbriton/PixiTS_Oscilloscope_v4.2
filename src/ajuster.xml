<file path="css/table.css">
/* ==========================================================================
   КОМПОНЕНТ ИНТЕРАКТИВНОЙ ТАБЛИЦЫ РЕГИСТРОВ (table.css)
   ========================================================================== */

.table-wrapper {
    flex: 1;
    overflow: auto; /* Включаем оба скролла сразу */
    background-color: #ffffff;
    border: 1px solid #7b7b7b;
    /* Убираем отступ сверху, оставляем остальные */
    margin: 2px 10px 10px 10px; 
    position: relative;
}

.table-wrapper .modbus-grid {
    table-layout: fixed; /* ВЕРНУЛИ FIXED: это критично для работы JS-ресайзера */
    width: 100%;         
    border-collapse: separate; 
    border-spacing: 0;         
    font-size: 14px;
    font-family: Arial, sans-serif;
    background-color: #ffffff;
    color: #000000;
}

.table-wrapper .modbus-grid th, 
.table-wrapper .modbus-grid td {
    border-bottom: none; 
    border-right: 1px solid #1d1b1a; 
    border-left: none;
    padding: 6px;
    text-align: center;
    white-space: nowrap;
    box-sizing: border-box;
    overflow: hidden;
    text-overflow: ellipsis;
    font-family: Arial, sans-serif;
    font-size: 14px;
    font-weight: normal;
    color: #000000;
}

.table-wrapper .modbus-grid th {
    font-weight: bold;
}

.table-wrapper .modbus-grid td .prm-val-display,
.table-wrapper .modbus-grid td .param-name,
.table-wrapper .modbus-grid td .param-desc,
.table-wrapper .modbus-grid td .hex-val,
.table-wrapper .modbus-grid td input,
.table-wrapper .modbus-grid td select {
    color: #000000;
    font-size: 14px;
    font-family: Arial, sans-serif;
}

.table-wrapper .modbus-grid th:first-child,
.table-wrapper .modbus-grid td:first-child {
    border-left: 1px solid #a0a0a0;
}

.table-wrapper .modbus-grid td {
    height: 24px;
}

.table-wrapper .modbus-grid .main-group { 
    background-color: #a6a6a6; 
}

/* =================================================================
   ФИКСАЦИЯ ШАПКИ
   ================================================================= */

.table-wrapper .modbus-grid thead th {
    position: sticky;
    background-color: #a8a7a7; 
    z-index: 10; /* Увеличили Z-index */
    color: #000000;
}

.table-wrapper .modbus-grid thead tr:nth-child(1) th {
    top: 0;
    z-index: 11;
    background-color: #dbdada;
}

/* ИЗМЕНЕНО: top уменьшен до 26px, чтобы убрать зазор между рядами шапки */
.table-wrapper .modbus-grid thead tr:nth-child(2) th {
    top: 26px;
    z-index: 10;
}

/* РАМКА ДЛЯ ВСЕЙ СТРОКИ "ПАРАМЕТРЫ" (второй ряд шапки) */
.table-wrapper .modbus-grid thead tr:nth-child(2) th {
    border-top: 1px solid #000000;
    border-bottom: 1px solid #000000;
}

.table-wrapper .modbus-grid thead tr:nth-child(2) th:first-child {
    border-left: 1px solid #000000;
}

.table-wrapper .modbus-grid thead tr:nth-child(2) th:last-child {
    border-right: 1px solid #000000;
}

/* =================================================================
   РЕСАЙЗЕРЫ (Сделали их активными поверх всего)
   ================================================================= */

.table-wrapper .table-resizer {
    position: absolute;
    top: 0;
    right: -4px; 
    width: 8px; 
    height: 100%; /* Ресайзер теперь на всю высоту шапки */
    cursor: col-resize;
    user-select: none;
    background-color: transparent;
    z-index: 100; /* Поверх sticky-шапки */
    pointer-events: auto;
}

.table-wrapper .modbus-grid thead tr:nth-child(2) .table-resizer {
    height: 24px; /* Корректируем высоту ресайзера, чтобы не перекрывал рамку */
}

.table-wrapper .table-resizer:hover, 
.table-wrapper .table-resizer.active {
    background-color: #0055ff;
}

/* Выделение строки */
.table-wrapper .modbus-grid tbody tr.is-selected,
.table-wrapper .modbus-grid tbody tr.is-selected td {
    background-color: rgba(0, 255, 0, 0.2);
}

/* Глобальное состояние загрузки */
.loading-state {
    cursor: wait;
    pointer-events: none; /* Блокирует клики на всем, пока идет загрузка */
}

/* Визуальный индикатор (вращающееся колечко) */
.loading-state::after {
    content: "";
    position: fixed;
    top: 50%;
    left: 50%;
    width: 40px;
    height: 40px;
    margin-left: -20px;
    margin-top: -20px;
    border: 4px solid #f3f3f3;
    border-top: 4px solid #3498db;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    z-index: 9999;
}

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}
</file>

<file path="css/toolbar.css">
/* ==========================================================================
   ВЕРХНИЙ ТУЛБАР И СТИЛИЗАЦИЯ КНОПОК ПО СТАНДАРТУ RETRO (toolbar.css)
   ========================================================================== */

.top-main-toolbar {
    width: 100%;
    background-color: #aeaeae;
    padding: 5px 10px;
    border-bottom: 2px solid #7b7b7b;
    display: flex;
    align-items: stretch; /* Автоматическое выравнивание по высоте элементов */
    gap: 5px;
    box-sizing: border-box;
    flex-shrink: 0;
    color: #000000;
    font-size: 14px;
    font-family: Arial, sans-serif;
}

.top-main-toolbar * {
    color: #000000;
    font-size: 14px;
    font-family: Arial, sans-serif;
}

/* Универсальный стиль управляющих кнопок с двойным обрамлением */
.tool-btn, 
.action-btn, 
.inline-btn, 
.refresh-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    height: auto;
    margin: 0;
    background-color: #c6c6c6;
    color: #000000;
    cursor: pointer;
    font-weight: bold;
    padding: 4px 12px;
    font-size: 14px;
    
    /* Двойное псевдо-обрамление */
    border: 1px solid #ffffff;      /* Наружный блик */
    outline: 1px solid #707070;     /* Внутренняя граница */
    box-shadow: inset 1px 1px 0px #ffffff, inset -1px -1px 0px #707070;
}

.tool-btn:hover, 
.action-btn:hover, 
.inline-btn:hover, 
.refresh-btn:hover {
    background-color: #e1e1e1;
    outline: 1px solid #0055ff;     /* Яркий синий фокус при наведении */
}

.tool-btn:active, 
.action-btn:active, 
.inline-btn:active, 
.refresh-btn:active {
    background-color: #a0a0a0;
    box-shadow: inset 2px 2px 2px #555555;
    outline: 1px solid #000000;
}

.refresh-btn { 
    margin-left: auto; /* Сдвигает кнопку обновления в крайний правый угол тулбара */
}

.tool-btn { 
    font-size: 14px; 
    padding: 3px 10px; 
}

/* Классическая сплит-кнопка (кнопка с раскрывающимся списком) */
.split-btn-group {
    display: inline-flex;
    align-items: stretch;
    position: relative;
    background-color: #c6c6c6;
    box-sizing: border-box;
    flex-shrink: 0;
    border: 1px solid #ffffff;      
    outline: 1px solid #707070;     
    box-shadow: inset 1px 1px 0px #ffffff, inset -1px -1px 0px #707070;
}

.split-btn-group button {
    background: transparent;
    border: none;
    outline: none;
    box-shadow: none;
    color: #000000;
    font-weight: bold;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    margin: 0;
    padding: 3px 8px;
}

.split-btn-main {
    font-size: 14px; 
}

.split-btn-arrow {
    font-size: 9px;  
    padding: 3px 5px !important;
}

.split-btn-group button:hover {
    background-color: #e1e1e1;
}

.split-btn-group button:active {
    background-color: #a0a0a0;
}

/* Внутренний механический разделитель сплит-кнопки */
.split-btn-divider {
    width: 1px;
    background-color: #707070;
    border-right: 1px solid #ffffff;
    margin: 3px 0;
    flex-shrink: 0;
}

/* Контейнер выпадающего меню файлов */
.split-dropdown-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: -1px;
    background-color: #c6c6c6;
    min-width: 130px;
    z-index: 9999;
    margin-top: 3px;
    box-sizing: border-box;
    border: 1px solid #ffffff;
    outline: 1px solid #707070;
    box-shadow: 2px 2px 6px rgba(0, 0, 0, 0.4);
}

.split-dropdown-menu.show {
    display: block;
}

.split-dropdown-item {
    padding: 5px 12px;
    font-size: 14px;
    color: #000000;
    cursor: pointer;
    text-align: left;
    user-select: none;
}

.split-dropdown-item:hover {
    background-color: #0055ff;
    color: #ffffff;
}


.sidebar-tree-container {
    height: 100%;            /* Ограничиваем высоту */
    overflow-y: auto;        /* Включает скроллбар при необходимости */
    background-color: #c6c6c6; 
    color: #000000;          /* ДОБАВЛЕНО: Явный черный цвет текста */
