/* Информационная плашка идентифицированного устройства */
.id-banner {
    background-color: #7b7b7b;
    color: #ffffff;
    font-weight: bold;
    padding: 4px 8px;
    font-size: 14px;
    margin-bottom: 8px;
    border: 1px solid #5a5a5a;
